# Server-only. Copy to .env.local and fill in. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Flash-class model ids. Confirm current availability in Google AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Best-effort process-local daily ceiling; the engine plan is returned when reached.
DAILY_LLM_CAP=200
